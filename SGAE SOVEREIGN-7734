.grid-3{grid-template-columns:repeat(auto-fit,minmax(260px,1fr));}
.grid-4{grid-template-columns:repeat(auto-fit,minmax(200px,1fr));}

/* ACTIONS */
.action-card{background:linear-gradient(160deg,#0d1117,#000);border:1px solid var(--gh-border);border-radius:12px;padding:1rem;margin-bottom:0.6rem;display:flex;gap:1rem;align-items:flex-start;transition:0.3s;}
.action-card:hover{border-color:var(--gh-blue);transform:translateX(4px);}
