.action-card .a-desc{font-size:0.68rem;color:var(--dim);line-height:1.6;}
.action-card code{background:rgba(88,166,255,0.1);color:var(--gh-blue);padding:2px 6px;border-radius:4px;font-family:'JetBrains Mono',monospace;font-size:0.62rem;}

/* FOOTER */
.footer{text-align:center;padding:1.5rem 1rem;background:linear-gradient(160deg,#02070e,#000);border:1px solid rgba(0,229,255,0.25);border-radius:16px;margin-top:1rem;font-size:0.62rem;color:var(--dim);line-height:1.8;}
