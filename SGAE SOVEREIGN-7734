.kpi.err{border-color:rgba(218,54,51,0.4);}
.kpi.err::before{background:linear-gradient(90deg,transparent,var(--gh-red),transparent);}
.kpi.warn{border-color:rgba(255,215,0,0.4);}
.kpi.warn::before{background:linear-gradient(90deg,transparent,var(--gold),transparent);}
.kpi .label{font-size:0.55rem;color:var(--dim);text-transform:uppercase;letter-spacing:0.1em;font-weight:700;margin-bottom:0.4rem;}
.kpi .value{font-family:'JetBrains Mono',monospace;font-size:1.3rem;font-weight:900;color:var(--cyan);line-height:1;}
.kpi.ok .value{color:var(--green);}
.kpi.err .value{color:var(--gh-red);}
.kpi.warn .value{color:var(--gold);}
