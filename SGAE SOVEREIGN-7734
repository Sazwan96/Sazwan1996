.cover .url-box{background:rgba(0,0,0,0.6);border:1px solid var(--gh-border);border-radius:10px;padding:10px 16px;font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--gh-blue);word-break:break-all;margin-bottom:1rem;position:relative;z-index:1;}

/* KPI */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0.8rem;margin-bottom:1.5rem;}
